{
  "name": "academic-universe-backend",
  "version": "1.0.0",
  "description": "SaaS backend for Academic Universe - Multi-tenant RBAC system",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "populate-overlap": "ts-node -r tsconfig-paths/register scripts/populateOverlapData.ts",
    "test-firestore": "ts-node -r tsconfig-paths/register scripts/testFirestoreConnection.ts",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "saas",
    "rbac",
    "multi-tenant",
    "academic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/express-session": "^1.18.2",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-session": "^1.19.0",
    "firebase-admin": "^13.7.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "tsconfig-paths": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^18.0.0",
    "@types/node-fetch": "^2.6.13",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.5.0",
    "node-fetch": "^2.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
