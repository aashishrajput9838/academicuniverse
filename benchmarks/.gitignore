# Never commit raw documents, API keys, or generated results
dataset/**/*.pdf
dataset/**/*.png
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/manifest.json

# Ground truth contains PII — keep out of version control
ground-truth/*.json
!ground-truth/SAMPLE_MS_ORG01_001.json

# Generated results — raw logs excluded (large files), reports included
results/logs/
# Allow human-readable reports and manuscript tables in version control
!results/
!results/reports/
!results/reports/**

# Node
node_modules/
dist/

# Environment
.env
.env.*
!.env.example
