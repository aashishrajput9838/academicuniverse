rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request comes from a service account (admin access)
    function isAdmin() {
      // Service accounts and users with admin claims have elevated privileges
      return request.auth != null && 
             (request.auth.token.get('admin', false) == true || 
              request.auth.token.get('claims', {}).get('admin', false) == true);
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user's organization ID
    function getUserOrganizationId() {
      return request.auth.token.get('organizationId', '');
    }
    
    // Helper function to check if user belongs to the same organization
    function isSameOrganization(docId) {
      return isAuthenticated() && 
             getUserOrganizationId() == get(/databases/$(database)/documents/sections/$(docId)).data.organizationId;
    }
    
    // Helper function to check if user has specific role
    function hasRole(role) {
      return isAuthenticated() && 
             request.auth.token.role == role;
    }
    
    // Helper function to check if user is super admin
    function isSuperAdmin() {
      return isAuthenticated() && 
             request.auth.token.isSuperAdmin == true;
    }
    
    // Sections collection - Organization-level access control
    match /sections/{sectionId} {
      // Allow read if user is authenticated and belongs to the same organization
      allow read: if isAuthenticated() && 
                     (isSameOrganization(sectionId) || isSuperAdmin()) ||
                     isAdmin();
      
      // Allow write only for service accounts, super admins or organization admins
      allow write: if isAdmin() || isSuperAdmin() || hasRole('ADMIN');
      
      // Additional organization isolation check
      allow read, write: if (isAuthenticated() || isAdmin()) && 
                            request.resource.data.organizationId == getUserOrganizationId();
    }
    
    // Timetables collection - Organization-level access control
    match /timetables/{sectionId} {
      // Allow read if user is authenticated and belongs to the same organization
      allow read: if isAuthenticated() && 
                     (isSameOrganization(sectionId) || isSuperAdmin()) ||
                     isAdmin();
      
      // Allow write only for service accounts, super admins or organization admins
      allow write: if isAdmin() || isSuperAdmin() || hasRole('ADMIN');
      
      // Additional organization isolation check
      allow read, write: if (isAuthenticated() || isAdmin()) && 
                            request.resource.data.organizationId == getUserOrganizationId();
    }
    
    // FreeSlots collection - Organization-level access control
    match /freeSlots/{sectionId} {
      // Allow read if user is authenticated and belongs to the same organization
      allow read: if isAuthenticated() && 
                     (isSameOrganization(sectionId) || isSuperAdmin()) ||
                     isAdmin();
      
      // Allow write only for service accounts, super admins or organization admins
      allow write: if isAdmin() || isSuperAdmin() || hasRole('ADMIN');
      
      // Additional organization isolation check
      allow read, write: if (isAuthenticated() || isAdmin()) && 
                            request.resource.data.organizationId == getUserOrganizationId();
    }
    
    // Users collection - User can only read their own data
    match /users/{userId} {
      allow read: if isAuthenticated() && 
                     (request.auth.uid == userId || isSuperAdmin()) ||
                     isAdmin();
      allow write: if isAdmin() || isSuperAdmin() || 
                       (request.auth.uid == userId && 
                        request.resource.data.organizationId == getUserOrganizationId());
    }
    
    // Organizations collection - Admin and super admin access
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && 
                     (getUserOrganizationId() == orgId || isSuperAdmin()) ||
                     isAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Ezone Sync Logs - Secure realtime automation logs
    match /ezoneLogs/{sessionId}/entries/{logId} {
      // Allow read if user is authenticated and is the owner (via firebaseUid) or belongs to the same organization
      allow read: if isAuthenticated() && 
                     (resource.data.firebaseUid == request.auth.uid || 
                      getUserOrganizationId() == resource.data.organizationId ||
                      isSuperAdmin()) ||
                     isAdmin();
      
      // Backend (Service Account) writes the logs via admin SDK
      allow write: if isAdmin();
    }
    
    // Roles collection - Admin and super admin access
    match /roles/{roleId} {
      allow read: if isAuthenticated() && 
                     (isSuperAdmin() || hasRole('ADMIN')) ||
                     isAdmin();
      allow write: if isAdmin() || isSuperAdmin() || hasRole('ADMIN');
    }
    
    // Additional security rules for overlap engine specific data
    match /overlapResults/{resultId} {
      // Only allow access to authenticated users from the same organization
      allow read, write: if (isAuthenticated() || isAdmin()) && 
                            request.resource.data.organizationId == getUserOrganizationId();
    }
    
    // Audit logs - Only super admins can access
    match /auditLogs/{logId} {
      allow read, write: if isAdmin() || isSuperAdmin();
    }
    
    // Detected events collection - User can only read their own events
    match /detected_events/{eventId} {
      allow read: if isAuthenticated() && 
                     (request.auth.uid == resource.data.userId || isSuperAdmin()) ||
                     isAdmin();
      allow write: if isAdmin();
    }
    
    // Default deny for any other collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}