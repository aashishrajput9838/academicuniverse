rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Ezone Sync Sessions - Publicly readable temporary automation telemetry
    // This allows realtime logs without requiring Firebase Auth on the frontend.
    // We use a flat recursive wildcard to ensure all documents under this path are readable.
    match /ezoneSyncSessions/{document=**} {
      allow read: if true;
      allow write: if false; // Only backend (Admin SDK) writes, which bypasses rules
    }

    // Helper function to check if request comes from a service account (admin access)
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.get('admin', false) == true || 
              request.auth.token.get('claims', {}).get('admin', false) == true);
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserOrganizationId() {
      return request.auth.token.get('organizationId', '');
    }
    
    function isSameOrganization(docId) {
      return isAuthenticated() && 
             getUserOrganizationId() == get(/databases/$(database)/documents/sections/$(docId)).data.organizationId;
    }
    
    function hasRole(role) {
      return isAuthenticated() && 
             request.auth.token.role == role;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && 
             request.auth.token.isSuperAdmin == true;
    }
    
    match /sections/{sectionId} {
      allow read: if isAuthenticated() && (isSameOrganization(sectionId) || isSuperAdmin()) || isAdmin();
      allow write: if isAdmin() || isSuperAdmin() || hasRole('ADMIN');
      allow read, write: if (isAuthenticated() || isAdmin()) && request.resource.data.organizationId == getUserOrganizationId();
    }
    
    match /timetables/{sectionId} {
      allow read: if isAuthenticated() && (isSameOrganization(sectionId) || isSuperAdmin()) || isAdmin();
      allow write: if isAdmin() || isSuperAdmin() || hasRole('ADMIN');
      allow read, write: if (isAuthenticated() || isAdmin()) && request.resource.data.organizationId == getUserOrganizationId();
    }
    
    match /freeSlots/{sectionId} {
      allow read: if isAuthenticated() && (isSameOrganization(sectionId) || isSuperAdmin()) || isAdmin();
      allow write: if isAdmin() || isSuperAdmin() || hasRole('ADMIN');
      allow read, write: if (isAuthenticated() || isAdmin()) && request.resource.data.organizationId == getUserOrganizationId();
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin()) || isAdmin();
      allow write: if isAdmin() || isSuperAdmin() || (request.auth.uid == userId && request.resource.data.organizationId == getUserOrganizationId());
    }
    
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (getUserOrganizationId() == orgId || isSuperAdmin()) || isAdmin();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /roles/{roleId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || hasRole('ADMIN')) || isAdmin();
      allow write: if isAdmin() || isSuperAdmin() || hasRole('ADMIN');
    }
    
    match /overlapResults/{resultId} {
      allow read, write: if (isAuthenticated() || isAdmin()) && request.resource.data.organizationId == getUserOrganizationId();
    }
    
    match /auditLogs/{logId} {
      allow read, write: if isAdmin() || isSuperAdmin();
    }
    
    match /detected_events/{eventId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isSuperAdmin()) || isAdmin();
      allow write: if isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
