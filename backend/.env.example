# Backend Configuration - Copy to .env and replace with your values
# DO NOT commit this file to git!

# Core Configuration
MONGODB_URI=mongodb+srv://your-mongodb-uri
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=7d
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# GitHub API Configuration
GITHUB_TOKEN=your-github-token
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Cloudinary Configuration
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Firebase Admin Configuration
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=your-google-redirect-uri

# Google Sheets Configuration
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_CLIENT_EMAIL=your-google-sheets-client-email
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_PRIVATE_KEY_ID=your-private-key-id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_X509_CERT_URL=your-google-client-x509-cert-url
GOOGLE_APPLICATION_CREDENTIALS=../serviceAccountKey.json.json

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# Log Analyzer Configuration
LOG_ANALYZER_URL=your-log-analyzer-url

# Sentry Error Tracking (Optional)
SENTRY_DSN=your-sentry-dsn

# Additional Google OAuth Fields
auth_provider_x509_cert_url=https://www.googleapis.com/oauth2/v1/certs
auth_uri=https://accounts.google.com/o/oauth2/auth
client_x509_cert_url=your-google-client-x509-cert-url
token_uri=https://oauth2.googleapis.com/token
universe_domain=googleapis.com
