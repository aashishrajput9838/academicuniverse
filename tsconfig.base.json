{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "./",
    "paths": {
      "@/*": ["./*"],
      "@shared-types/*": ["./packages/shared-types/src/*"],
      "@shared-types": ["./packages/shared-types/src/index.ts"],
      "@academicuniverse/shared-types/*": ["./packages/shared-types/src/*"],
      "@academicuniverse/shared-types": ["./packages/shared-types/src/index.ts"],
      "@shared-utils/*": ["./packages/shared-utils/src/*"],
      "@shared-utils": ["./packages/shared-utils/src/index.ts"],
      "@academicuniverse/shared-utils/*": ["./packages/shared-utils/src/*"],
      "@academicuniverse/shared-utils": ["./packages/shared-utils/src/index.ts"]
    }
  }
}
