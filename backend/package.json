{
  "name": "academic-universe-backend",
  "version": "1.0.0",
  "description": "SaaS backend for Academic Universe - Multi-tenant RBAC system",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "postinstall": "npx playwright install --with-deps chromium",
    "seed": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register scripts/seed.ts",
    "populate-overlap": "ts-node -r tsconfig-paths/register scripts/populateOverlapData.ts",
    "test-firestore": "ts-node -r tsconfig-paths/register scripts/testFirestoreConnection.ts",
    "test": "jest --runInBand",
    "test:growth": "jest --runInBand --testMatch \"**/tests/growth.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "saas",
    "rbac",
    "multi-tenant",
    "academic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.45.0",
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "@types/express-session": "^1.18.2",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "connect-mongo": "^5.1.0",
    "docxtemplater": "^3.68.3",
    "dotenv": "^16.6.1",
    "express": "^4.18.0",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.10.1",
    "firebase-admin": "^13.7.0",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.0",
    "mammoth": "^1.12.0",
    "mongodb": "^7.0.0",
    "mongoose": "^7.0.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^5.0.0",
    "pizzip": "^3.2.0",
    "playwright": "^1.60.0",
    "sharp": "^0.33.5",
    "tesseract.js": "^7.0.0",
    "tsconfig-paths": "^4.1.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "jspdf": "^4.2.1",
    "docx": "^9.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^18.0.0",
    "@types/node-fetch": "^2.6.13",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "jest": "^29.5.0",
    "node-fetch": "^2.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
